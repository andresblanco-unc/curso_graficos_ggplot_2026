## faceting ----
G2 <- ggplot(datos_peces,
aes(temperatura_C, cortisol_ugdL,
col = sitio)) +
geom_point(size = 3) +
theme_bw(); G2
G2 + facet_grid(. ~ sitio) +
guides(col = FALSE)  # elimino la leyenda
G2 + facet_grid(. ~ especie)  # para dividir verticalmente
G2 + facet_grid(especie ~ .)  # para dividir horizontalmente
G2 + facet_grid(sexo ~ especie)  # para dividir por ambas
G2 + facet_wrap(~ especie)
G2 + facet_wrap(~ especie, scales = "free")
G2 + facet_wrap(~ especie,
scales = "free",
ncol = 1)
# modificar la etiqueta de los facetings
# opción 1 modificar la base
datos_peces %>%
mutate(especie = fct_recode(especie,
"O. bonariensis" = "Odontesthes bonariensis",
"J. multidentata" = "Jenynsia multidentata",
"C. dimerus" = "Cichlasoma dimerus")) %>%
ggplot(aes(temperatura_C, cortisol_ugdL,
col = sitio)) +
geom_point(size = 3) +
facet_grid(. ~ especie)
# opción 2 labeller
datos_peces %>%
ggplot(aes(temperatura_C, cortisol_ugdL,
col = sitio)) +
geom_point(size = 3) +
facet_grid(. ~ especie,
labeller= labeller(especie = c(
"Odontesthes bonariensis" = "O. bonariensis",
"Jenynsia multidentata" = "J. multidentata",
"Cichlasoma dimerus" = "C. dimerus")))
