percent_Prod = Production / sum(Production) * 100,
label_y      = cumsum(Production),
label_y_perc = cumsum(percent_Prod)
) %>%
ungroup()
soja_apilado_otros %>%
ggplot(aes(x = factor(Year), y = Production,
fill = fct_rev(Area))) +
geom_col() +
geom_text(aes(label = round(Production, 1), y = label_y),
vjust = 1.5, size = 3) +
labs(x = "Año", y = "Producción (millones de Tn)", fill = "País") +
THEME
soja_apilado_otros %>%
ggplot(aes(x = factor(Year), y = percent_Prod,
fill = fct_rev(Area))) +
geom_col() +
geom_text(aes(label = round(percent_Prod, 1), y = label_y_perc),
vjust = 2, size = 3) +
labs(x = "Año", y = "Porcentaje de la producción mundial", fill = "País") +
THEME
soja_apilado_otros <- soja_paises %>%
filter(Year %in% años_seleccion) %>%
select(Area, Year, Production) %>%
pivot_wider(names_from = Area, values_from = Production) %>%
mutate(
"Otros" = World - Brazil - USA - Argentina - China - India - Paraguay
) %>%
select(1, 3:9) %>%
pivot_longer(c(`Argentina`, `Brazil`, `USA`,
`China`,`India`,`Paraguay`,
`Otros`,),
names_to  = "Area",
values_to = "Production") %>%
filter(Production>2) %>%
mutate(Area = factor(Area,
levels = c("Brazil", "USA", "Argentina",
"China", "India", "Paraguay",
"Otros"))) %>%
group_by(Year) %>%
arrange(Year, Area) %>%
mutate(
percent_Prod = Production / sum(Production) * 100,
label_y      = cumsum(Production),
label_y_perc = cumsum(percent_Prod)
) %>%
ungroup()
soja_apilado_otros %>%
ggplot(aes(x = factor(Year), y = Production,
fill = fct_rev(Area))) +
geom_col() +
geom_text(aes(label = round(Production, 1), y = label_y),
vjust = 1.5, size = 3) +
labs(x = "Año", y = "Producción (millones de Tn)", fill = "País") +
THEME
