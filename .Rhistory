library(rmarkdown)
## Cargado de las librerías --------------------
library(tidyverse)
library(agricolae);  library(car) ;
library(sciplot) ; library(patchwork): library(gridExtra)
ACT1.1 <- datos_peces %>%
filter(especie == "Cichlasoma dimerus" | especie == "Odontesthes bonariensis") %>%
filter(sitio == "Laguna Norte", temporada == "Invierno" )
ACT1.2 <- ACT1.1 %>%
mutate(peso_relativo = peso_g/longitud_cm) %>%
filter(peso_relativo > 1)
# Actividad 2a ---------------
# Genere bases de datos para cada una de las especies y analice
# si existe una correlación entre longitud_cm, peso_g, cortisol
# en sangre, temperatura y transparencia. Realice un gráfico con
# corrplot y otro con chart.Correlation, explore posibilidades de
# las funciones en la sección ayuda.
C.dimerus <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[1])
J.multidentata <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[2])
O.bonariensis <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[3])
setwd("D:/OneDrive/R/Taller R 2026 Doctorado/")
datos_peces <- read_csv("data/peces_morfometria.csv")
ACT1.1 <- datos_peces %>%
filter(especie == "Cichlasoma dimerus" | especie == "Odontesthes bonariensis") %>%
filter(sitio == "Laguna Norte", temporada == "Invierno" )
ACT1.2 <- ACT1.1 %>%
mutate(peso_relativo = peso_g/longitud_cm) %>%
filter(peso_relativo > 1)
# Actividad 2a ---------------
# Genere bases de datos para cada una de las especies y analice
# si existe una correlación entre longitud_cm, peso_g, cortisol
# en sangre, temperatura y transparencia. Realice un gráfico con
# corrplot y otro con chart.Correlation, explore posibilidades de
# las funciones en la sección ayuda.
C.dimerus <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[1])
J.multidentata <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[2])
O.bonariensis <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[3])
library(Hmisc)
CORR_C_dimerus <- rcorr(as.matrix(C.dimerus[,6:10]))
CORR_J_multidentata <- rcorr(as.matrix(J.multidentata[,6:10]))
CORR_O_bonariensis <- rcorr(as.matrix(O.bonariensis[,6:10]))
# C. dimerus
library(corrplot) ; library(PerformanceAnalytics)
corrplot(CORR_C_dimerus$r)
chart.Correlation(C.dimerus[,6:10],
histogram=TRUE,
method = "pearson",
pch=19)
# J. multidentata
library(corrplot) ; library(PerformanceAnalytics)
corrplot(CORR_J_multidentata$r)
chart.Correlation(J.multidentata[,6:10],
histogram=TRUE,
method = "pearson",
pch=19)
# O. bonariensis
library(corrplot) ; library(PerformanceAnalytics)
corrplot(CORR_O_bonariensis$r)
chart.Correlation(O.bonariensis[,6:10],
histogram=TRUE,
method = "pearson",
pch=19)
REG2.b <- lm(peso_g~longitud_cm, data = ACT1.1)
layout(matrix(1:4, 2, 2)); plot(REG2.b) ;layout(1)
shapiro.test(resid(REG2.b))
summary(REG2.b)
lineplot.CI(data = ACT1.1,
x.factor = longitud_cm,
response = peso_g,
group = especie)
lineplot.CI(data = ACT1.1,
x.factor = longitud_cm,
response = peso_g,
group = especie,
x.cont = TRUE)
