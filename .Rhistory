# ojo al position
# Argentina y mundo superpuesta, no apilado
ggplot(soja_arg_mundo, aes(Year, Sup, fill = Area)) +
geom_area(col = "gray21", position = "dodge") +
scale_y_continuous(expand = c(0, 0), breaks = seq(0, 150, by = 10)) +
scale_x_continuous(expand = c(0, 0), breaks = seq(1960, 2025, by = 5)) +
labs(x = "Años",
y = "Superficie sembrada (millones de ha)") +
THEME
# Argentina y mundo superpuesta, no apilado sin leyenda
ggplot(soja_mundo, aes(Year, Sup)) +
geom_area(fill = "burlywood3", col = "black") +
geom_area(data = soja_argentina, aes(Year, Sup),
fill = "cornflowerblue", col = "black") +
annotate("text", x = 2008, y = 8, label = "Argentina", size = 6) +
annotate("text", x = 1990, y = 35, label = "Mundo", size = 6)
ggplot(soja_mundo, aes(Year, Sup)) +
geom_area(fill = "burlywood3", col = "gray21") +
scale_y_continuous(expand = c(0, 0), breaks = seq(0, 120, by = 10)) +
scale_x_continuous(expand = c(0, 0), breaks = seq(1960, 2025, by = 5)) +
labs(x = "Años",
y = "Superficie sembrada (millones de ha)") +
geom_area(data = soja_argentina, aes(Year, Sup),
fill = "cornflowerblue", col = "gray21") +
annotate("text", x = 2008, y = 8,  label = "Argentina", size = 6) +
annotate("text", x = 1990, y = 35, label = "Mundo",     size = 6) +
THEME
## Biplot para multivariado -----
library(factoextra); library(FactoMineR); library(ggrepel)
# Usamos las variables numéricas de la base de peces, agrupando por especie
# Variables: longitud_cm, peso_g, temperatura_C, transparencia_cm, cortisol_ugdL
datos_peces <- read_csv("data/peces_morfometria.csv")
res.pca <- PCA(datos_peces[, c("longitud_cm", "peso_g",
"temperatura_C", "transparencia_cm",
"cortisol_ugdL")],
scale.unit = TRUE)
VARIANCE <- round(get_eigenvalue(res.pca)[, 2], 2)
fviz_pca_biplot(res.pca)
fviz_pca_biplot(res.pca,
repel        = TRUE,
geom.ind     = "point",
col.var      = "deeppink4",
col.ind      = "black",
labelsize    = 5,
axes.linetype = "blank",
alpha.var    = 0.5)
fviz_pca_biplot(res.pca,
repel        = TRUE,
geom.ind     = "point",
col.var      = "deeppink4",
col.ind      = "black",
labelsize    = 5,
axes.linetype = "blank",
alpha.var    = 0.5,
title        = NULL) +
geom_point(aes(col = datos_peces$especie), size = 4) +
geom_hline(yintercept = 0, linetype = "dotted", col = "grey30") +
geom_vline(xintercept = 0, linetype = "dotted", col = "grey30") +
theme(text     = element_text(size = 14, colour = "black")) +
theme(axis.text = element_text(size = 14, colour = "black")) +
labs(x     = paste("PC 1 (", VARIANCE[[1]], "%)"),
y     = paste("PC 2 (", VARIANCE[[2]], "%)"),
col   = "Especie") +
scale_y_continuous(expand = c(0, 0), limits = c(-3, 3),
breaks = seq(-40, 40, by = 1)) +
scale_x_continuous(expand = c(0, 0), limits = c(-5.5, 5.5),
breaks = seq(-9, 9, by = 2)) +
scale_colour_viridis_d() +
THEME
fviz_pca_biplot(res.pca,
repel        = TRUE,
geom.ind     = "point",
col.var      = "deeppink4",
col.ind      = "black",
labelsize    = 5,
axes.linetype = "blank",
alpha.var    = 0.5)
fviz_pca_biplot(res.pca,
repel        = TRUE,
geom.ind     = "point",
col.var      = "deeppink4",
col.ind      = "black",
labelsize    = 5,
axes.linetype = "blank",
alpha.var    = 0.5,
title        = NULL) +
geom_point(aes(col = datos_peces$especie), size = 4) +
geom_hline(yintercept = 0, linetype = "dotted", col = "grey30") +
geom_vline(xintercept = 0, linetype = "dotted", col = "grey30") +
theme(text     = element_text(size = 14, colour = "black")) +
theme(axis.text = element_text(size = 14, colour = "black")) +
labs(x     = paste("PC 1 (", VARIANCE[[1]], "%)"),
y     = paste("PC 2 (", VARIANCE[[2]], "%)"),
col   = "Especie") +
scale_y_continuous(expand = c(0, 0), limits = c(-3, 3),
breaks = seq(-40, 40, by = 1)) +
scale_x_continuous(expand = c(0, 0), limits = c(-5.5, 5.5),
breaks = seq(-9, 9, by = 2)) +
scale_colour_viridis_d() +
THEME
library(rmarkdown)
## Cargado de las librerías --------------------
library(tidyverse)
library(agricolae);  library(car) ;
library(sciplot) ; library(patchwork): library(gridExtra)
ACT1.1 <- datos_peces %>%
filter(especie == "Cichlasoma dimerus" | especie == "Odontesthes bonariensis") %>%
filter(sitio == "Laguna Norte", temporada == "Invierno" )
ACT1.2 <- ACT1.1 %>%
mutate(peso_relativo = peso_g/longitud_cm) %>%
filter(peso_relativo > 1)
# Actividad 2a ---------------
# Genere bases de datos para cada una de las especies y analice
# si existe una correlación entre longitud_cm, peso_g, cortisol
# en sangre, temperatura y transparencia. Realice un gráfico con
# corrplot y otro con chart.Correlation, explore posibilidades de
# las funciones en la sección ayuda.
C.dimerus <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[1])
J.multidentata <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[2])
O.bonariensis <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[3])
setwd("D:/OneDrive/R/Taller R 2026 Doctorado/")
datos_peces <- read_csv("data/peces_morfometria.csv")
ACT1.1 <- datos_peces %>%
filter(especie == "Cichlasoma dimerus" | especie == "Odontesthes bonariensis") %>%
filter(sitio == "Laguna Norte", temporada == "Invierno" )
ACT1.2 <- ACT1.1 %>%
mutate(peso_relativo = peso_g/longitud_cm) %>%
filter(peso_relativo > 1)
# Actividad 2a ---------------
# Genere bases de datos para cada una de las especies y analice
# si existe una correlación entre longitud_cm, peso_g, cortisol
# en sangre, temperatura y transparencia. Realice un gráfico con
# corrplot y otro con chart.Correlation, explore posibilidades de
# las funciones en la sección ayuda.
C.dimerus <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[1])
J.multidentata <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[2])
O.bonariensis <- datos_peces %>% filter(especie == levels(as.factor(datos_peces$especie))[3])
library(Hmisc)
CORR_C_dimerus <- rcorr(as.matrix(C.dimerus[,6:10]))
CORR_J_multidentata <- rcorr(as.matrix(J.multidentata[,6:10]))
CORR_O_bonariensis <- rcorr(as.matrix(O.bonariensis[,6:10]))
# C. dimerus
library(corrplot) ; library(PerformanceAnalytics)
corrplot(CORR_C_dimerus$r)
chart.Correlation(C.dimerus[,6:10],
histogram=TRUE,
method = "pearson",
pch=19)
# J. multidentata
library(corrplot) ; library(PerformanceAnalytics)
corrplot(CORR_J_multidentata$r)
chart.Correlation(J.multidentata[,6:10],
histogram=TRUE,
method = "pearson",
pch=19)
# O. bonariensis
library(corrplot) ; library(PerformanceAnalytics)
corrplot(CORR_O_bonariensis$r)
chart.Correlation(O.bonariensis[,6:10],
histogram=TRUE,
method = "pearson",
pch=19)
REG2.b <- lm(peso_g~longitud_cm, data = ACT1.1)
layout(matrix(1:4, 2, 2)); plot(REG2.b) ;layout(1)
shapiro.test(resid(REG2.b))
summary(REG2.b)
lineplot.CI(data = ACT1.1,
x.factor = longitud_cm,
response = peso_g,
group = especie)
lineplot.CI(data = ACT1.1,
x.factor = longitud_cm,
response = peso_g,
group = especie,
x.cont = TRUE)
