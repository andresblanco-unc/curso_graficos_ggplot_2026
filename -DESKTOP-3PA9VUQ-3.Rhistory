## Escalas ----
### Escalas en los ejes ----
G3 +
scale_x_discrete(labels = c("L. Central", "L. Norte",  "L. Sur")) +
scale_y_continuous(expand = c(0, 0),  # expande al borde
limits = c(0, 10),  # límites del gráfico
breaks = seq(0, 10, by = 1))  # división del eje
G3 +
scale_y_continuous(expand = c(0, 0),
limits = c(0, 10),
breaks = c(2, 5, 8))  # puedo definir ciertos valores
# invertir ejes
G3 +
scale_x_discrete(position = "top")
# cambiar el orden
G3 +
scale_x_discrete(limits = c("Laguna Norte", "Laguna Central", "Laguna Sur"))
# hacer zoom
G3 +
scale_x_discrete(labels = c("L. Central", "L. Norte",  "L. Sur")) +
scale_y_continuous(expand = c(0, 0),
limits = c(3, 10),
breaks = seq(0, 10, by = 1))
G3 +
scale_x_discrete(labels = c("L. Central", "L. Norte",  "L. Sur")) +
scale_y_continuous(expand = c(0, 0),
limits = c(0, 10),
breaks = seq(0, 10, by = 1)) +
coord_cartesian(ylim = c(2, 8))  # hacemos un zoom
# Guardamos uno
G3 <- G3 +
scale_y_continuous(expand = c(0, 0),
limits = c(0, 8),
breaks = seq(0, 10, by = 1)) ; G3
